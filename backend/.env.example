# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/halkabite
CLIENT_URL=http://localhost:5173

# Security
JWT_SECRET=

# Google Gemini
GEMINI_API_KEY=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OpenStreetMap/Nominatim identification
NOMINATIM_USER_AGENT=HalkaBite/1.0 (contact@example.com)

# Development seed account (only needed by seedRestaurantOwner)
SEED_RESTAURANT_EMAIL=owner@example.com
SEED_RESTAURANT_PASSWORD=
